[
  {
    // src/openocd -s tcl -f interface/cmsis-dap.cfg -f target/rp2350.cfg -c "adapter speed 5000"

    "label": "OpenOCD",
    "command": "$ZED_WORKTREE_ROOT/../openocd/src/openocd",
    "args": [
      "-s",
      "$ZED_WORKTREE_ROOT/../openocd/tcl",
      "-f",
      "interface/cmsis-dap.cfg",
      "-f",
      "target/rp2350.cfg",
      "-c",
      "'adapter speed 5000'",
    ],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
  },
  {
    "label": "Flash",
    "command": "$ZED_WORKTREE_ROOT/../openocd/src/openocd",
    "args": [
      "-s",
      "$ZED_WORKTREE_ROOT/../openocd/tcl",
      "-f",
      "interface/cmsis-dap.cfg",
      "-f",
      "target/rp2350.cfg",
      "-c",
      "program zig-out/firmware/pico-debug.elf verify reset exit",
    ],
    "use_new_terminal": false,
  },
  {
    "label": "Build",
    "command": "zig",
    "args": ["build"],
    "use_new_terminal": false,
  },
  {
    "label": "probe-rs DAP Server",
    "command": "probe-rs",
    "args": ["dap-server", "--port", "50000"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
  },
]
